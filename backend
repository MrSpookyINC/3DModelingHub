<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>3D Modeling Hub</title>
  <style>
    /* HOME HERO SECTION */
.home-hero {
  text-align: center;
  margin-bottom: 30px;
}

.home-hero h2 {
  font-size: 2.5rem;
  color: #ffffff;
  margin-bottom: 10px;
}

.home-hero p {
  font-size: 1.2rem;
  color: rgba(255, 255, 255, 0.8);
}

/* HOME PAGE CARDS */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.card {
  background: rgba(255, 255, 255, 0.1);
  padding: 20px;
  border-radius: 20px;
  text-align: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
  transform: translateY(-10px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 15px;
  margin-bottom: 15px;
}

.card h3 {
  font-size: 1.5rem;
  color: #ffffff;
  margin-bottom: 10px;
}

.card p {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20px;
}

.cta-button {
  padding: 10px 20px;
  background: linear-gradient(90deg, #007bff, #0056b3);
  border: none;
  border-radius: 10px;
  color: #fff;
  font-size: 1rem;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.cta-button:hover {
  background: linear-gradient(90deg, #0056b3, #007bff);
}

    /* GENERAL RESET */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* BODY STYLING */
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #3a3a3a, #1e1e2f);
      color: #fff;
      line-height: 1.6;
    }

    /* HEADER */
    header {
      background: rgba(0, 0, 0, 0.5);
      padding: 20px 0;
      text-align: center;
    }

    header h1 {
      font-size: 2.5rem;
      font-weight: 700;
    }

    /* NAVIGATION BAR */
    nav {
      display: flex;
      justify-content: center;
      background: rgba(0, 0, 0, 0.3);
      padding: 15px 0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    nav a {
      margin: 0 15px;
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      font-size: 1rem;
      padding: 8px 15px;
      border-radius: 5px;
      transition: background-color 0.3s ease;
    }

    nav a:hover {
      background-color: rgba(255, 255, 255, 0.2);
    }

    /* GENERAL CONTAINER */
    .container {
      max-width: 1200px;
      margin: 30px auto;
      padding: 20px;
    }

    /* FORM STYLING */
    .form-container {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);
      max-width: 400px;
      margin: auto;
      color: #fff;
      text-align: center;
    }

    .form-container h2 {
      font-size: 2rem;
      margin-bottom: 20px;
    }

    .form-container input,
    .form-container select,
    .form-container textarea {
      width: 100%;
      padding: 15px;
      margin-bottom: 15px;
      border: none;
      border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.2);
      color: #fff;
      font-size: 1rem;
      outline: none;
    }

    .form-container input::placeholder {
      color: rgba(255, 255, 255, 0.7);
    }

    .form-container label {
      font-size: 1rem;
      margin-bottom: 5px;
      display: block;
      color: rgba(255, 255, 255, 0.8);
      text-align: left;
    }

    .form-container .main-button {
      width: 100%;
      padding: 15px;
      background: linear-gradient(90deg, #007bff, #0056b3);
      color: #fff;
      font-size: 1rem;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .form-container .main-button:hover {
      background: linear-gradient(90deg, #0056b3, #007bff);
    }

    .hidden {
      display: none;
    }
  </style>
  <style>
/* Existing styles (leave them as they are) */

/* NEW: SECTION TITLE */
.section-title {
  text-align: center;
